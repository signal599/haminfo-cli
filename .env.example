DATABASE_URL=
GEOCODIO_API_KEY=
GOOGLE_GEOCODE_API_KEY=
GEOCODE_BATCH_SIZE=
# Enabled only by 1/true/yes/on. Any other value, including "false", disables it.
BATCH_GEOCODING_ENABLED=true
# Send Geocodio failures to Google for a cleaned-up address and retry. Enabled only by
# 1/true/yes/on. Any other value, including "false", disables it.
GEOCODE_ADDRESS_CLEANUP_ENABLED=true
# Roll through the whole database re-geocoding completed rows when there is spare batch
# capacity. Enabled only by 1/true/yes/on. Any other value, including "false", disables it.
GEOCODE_REGEOCODE_ENABLED=false
# Enabled only by 1/true/yes/on. Any other value, including "false", disables it.
ZIP_GEOCODE_ENABLED=false
ZIP_GEOCODE_BATCH_SIZE=
REVALIDATE_URL=
REVALIDATE_TOKEN=
EXPORT_DIR=
EXPORT_PUBLIC_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
